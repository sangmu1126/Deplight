# ============================================
# Deplight Platform Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==================
# AWS Configuration
# ==================
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=your_account_id_here

# S3 Buckets
S3_ARTIFACTS_BUCKET=delightful-deploy-artifacts-513348493870
S3_CODEDEPLOY_BUCKET=delightful-deploy-artifacts-513348493870

# ECR Configuration
ECR_REPOSITORY=delightful-deploy

# ==================
# API Keys
# ==================

# OpenAI API (server-side only; never expose this in the dashboard frontend)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# ==================
# SSM Parameter Names
# ==================
SSM_OPENAI_API_KEY=/delightful-deploy/openai-api-key
SSM_SLACK_WEBHOOK=/delightful/slack/webhook_url
SSM_GITHUB_TOKEN=/delightful/github/token

# ==================
# GitHub Configuration (Optional)
# ==================
# GitHub Personal Access Token with 'repo' permissions
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=

# ==================
# Slack Notification (Optional)
# ==================
# Slack Incoming Webhook URL for deployment notifications
SLACK_WEBHOOK_URL=

# ==================
# Infrastructure
# ==================
# Application Load Balancer DNS (auto-generated after deployment)
# Optionally override at runtime; otherwise discovered by pipeline
ALB_DNS=
